# Telegram
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
BOT_USERNAME=BooklyBot
WEBAPP_URL=https://app.example.com

# Database
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://bookly:CHANGE_THIS@db:5432/bookly

# Public URLs
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Paddle environment switch
# Change ONLY this value when switching the active environment.
PADDLE_ENV=sandbox

# Paddle Sandbox (backend)
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_SANDBOX_BOOKLY_BASE_PRICE_ID=
PADDLE_SANDBOX_SERVICE_ADDON_20_PRICE_ID=
PADDLE_SANDBOX_SERVICE_ADDON_30_PRICE_ID=
PADDLE_SANDBOX_SERVICE_ADDON_50_PRICE_ID=
PADDLE_SANDBOX_SERVICE_ADDON_100_PRICE_ID=

# Paddle Live (backend)
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_LIVE_BOOKLY_BASE_PRICE_ID=
PADDLE_LIVE_SERVICE_ADDON_20_PRICE_ID=
PADDLE_LIVE_SERVICE_ADDON_30_PRICE_ID=
PADDLE_LIVE_SERVICE_ADDON_50_PRICE_ID=
PADDLE_LIVE_SERVICE_ADDON_100_PRICE_ID=

# Paddle Sandbox (frontend/Vite)
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_SANDBOX_CLIENT_TOKEN=
VITE_PADDLE_SANDBOX_BOOKLY_BASE_PRICE_ID=
VITE_PADDLE_SANDBOX_SERVICE_ADDON_20_PRICE_ID=
VITE_PADDLE_SANDBOX_SERVICE_ADDON_30_PRICE_ID=
VITE_PADDLE_SANDBOX_SERVICE_ADDON_50_PRICE_ID=
VITE_PADDLE_SANDBOX_SERVICE_ADDON_100_PRICE_ID=

