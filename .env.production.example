VITE_PADDLE_LIVE_BOOKLY_BASE_PRICE_ID=
VITE_PADDLE_LIVE_SERVICE_ADDON_20_PRICE_ID=
VITE_PADDLE_LIVE_SERVICE_ADDON_30_PRICE_ID=
VITE_PADDLE_LIVE_SERVICE_ADDON_50_PRICE_ID=
VITE_PADDLE_LIVE_SERVICE_ADDON_100_PRICE_ID=

# Legacy frontend variable is no longer required by the new bridge.
# Keep it only temporarily if another deployment still references it.
